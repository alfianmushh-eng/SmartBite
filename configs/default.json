{
  "model": {
    "backbone": "efficientnet_b3",
    "num_classes": 210,
    "input_size": [224, 224],
    "pretrained": true,
    "dropout": 0.3,
    "freeze_backbone": false
  },
  "training": {
    "batch_size": 64,
    "epochs": 100,
    "learning_rate": 0.0001,
    "weight_decay": 1e-5,
    "warmup_steps": 500,
    "mixed_precision": true,
    "gradient_clip": 1.0,
    "early_stopping_patience": 10,
    "val_split": 0.15,
    "test_split": 0.10
  },
  "data": {
    "image_size": [224, 224],
    "augment_train": true,
    "normalize": true,
    "cache_images": false
  },
  "device": "cuda",
  "seed": 42
}